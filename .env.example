# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Gemini Model Identifier (Default: gemini-1.5-pro, or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-pro

# Optional: Enable local LaMini-Flan-T5-783M model (requires torch and transformers)
# Defaults to false (graceful Gemini fallback is used automatically)
ENABLE_LOCAL_LAMINI=false
